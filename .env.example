# 通义 DashScope API Key（在 https://bailian.console.aliyun.com 创建）
DASHSCOPE_API_KEY=sk-your-api-key-here

# OpenAI 兼容接口（LangChain 使用）
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# 模型配置
CHAT_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v4
# 意图识别（先 LLM 判意图，再检索 / 分流）
INTENT_LLM=true
# 留空则与 CHAT_MODEL 相同；意图分类用普通对话模型即可，无需推理模型
INTENT_MODEL=
# 答案润色温度（0=更少臆造）
ANSWER_TEMPERATURE=0

# 向量库路径（本地 Qdrant，无需 Docker）
QDRANT_PATH=./data/qdrant_db
COLLECTION_NAME=customer_service_kb

# RAG 参数
TOP_K=4
# 澄清阈值：低于此分数丢弃；FAQ 落在 [澄清, 直出) 会返回候选问列表
CLARIFY_THRESHOLD=0.45
# 直出阈值：FAQ 分数达到此值直接返回标准答案（不调用大模型改写）
DIRECT_THRESHOLD=0.72
CLARIFY_COUNT=3
# 每条 FAQ 最多入库的相似问数量（标准问始终入库；超出部分忽略）
FAQ_MAX_SIMILAR=30
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# 混合检索（向量 + BM25）与精排（DashScope）
HYBRID_SEARCH=true
HYBRID_VECTOR_K=20
HYBRID_BM25_K=20
RERANK_ENABLED=true
RERANK_MODEL=gte-rerank-v2
RERANK_TOP_N=8
# 精排噪声底线（绝对）；口语改写常见 ~0.15–0.25，勿再设成 0.25 一刀切
RERANK_MIN_SCORE=0.05
# 近原句高相关带；低于此带时需词面/BM25 佐证才放行
RERANK_HIGH_SCORE=0.50
# 相对门槛：候选精排分须 >= 本轮最高分 * 该比例
RERANK_RELATIVE=0.65

# 话术：data/bot_config.json（也可在运营后台「话术配置」热更新）；模板 data/bot_scripts_template.json
# 敏感词表见 data/sensitive.db（API 热更新，无需重启）
# 词表示例：data/sensitive.txt → POST /sensitive-words/import {"path":"data/sensitive.txt"}
# 回归用例：uv run python -m src.regression

# FastAPI：uv run replykit  或  uv run replykit-api
# 前端：cd web && npm run dev（默认 http://127.0.0.1:5173，proxy 到本 API）
API_HOST=127.0.0.1
API_PORT=8000
# JWT 鉴权：POST /auth/login → Authorization: Bearer <access_token>
# JWT_SECRET 至少 32 字符；生产请换成足够长的随机串
JWT_SECRET=change-me-to-a-long-random-jwt-secret-32chars
JWT_ACCESS_TTL=7200
JWT_REFRESH_TTL=604800
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password
# 是否开放自助注册（生产可设 false）
AUTH_ALLOW_REGISTER=true
AUTH_DB_PATH=./data/auth.db
# 配图公共前缀（可选）。留空则 /chat 按请求 Host 拼绝对 URL，如 http://127.0.0.1:8000/assets/...
# 飞书任务查询 OAuth 回调也依赖此地址：须配置为公网可达的 https://你的域名
# 并在飞书开放平台「安全设置 → 重定向 URL」填写 {ASSET_BASE_URL}/oauth/feishu/callback
# ASSET_BASE_URL=http://127.0.0.1:8000
# 会话持久化（SQLite）：同 session_id 重启后可续聊
SESSION_DB_PATH=./data/sessions.db
# ChatSession 热数据缓存 TTL（Redis 场景 3: Write-Through + TTL 冷热淘汰）
# 30min 内无 get/save 访问自动从 Redis 冷出，让位给活跃会话；命中则刷新 TTL
SESSION_CACHE_TTL=1800

# --- Redis (可选：JWT 黑名单 + 登录限流 + ChatSession 热缓存) ---
# Windows 开发环境建议 WSL2 Ubuntu 运行 Redis: 见 scripts/wsl_setup_redis.sh
# REDIS_URL 格式: redis://[:password@]host:port[/db]
# WSL2 场景: 把 host 换成 WSL2 的 eth0 IP (Ubuntu 内运行 hostname -I 取首个)
REDIS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379/0
# 登录限流: 5 次失败 / 窗口 300 秒 (5min)
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SEC=300

# --- Apache Tika (通用文档解析：知识库文档 + FAQ 导入统一用它) ---
# Windows 开发环境建议 WSL2 Ubuntu 运行 Tika Server: 见 scripts/wsl_setup_tika.sh
# 依赖 Java 17+: Ubuntu 内 apt install openjdk-17-jre-headless
# WSL2 场景: 把 host 换成 WSL2 的 eth0 IP (与 REDIS_URL 同样做法)
TIKA_ENABLED=true
TIKA_URL=http://127.0.0.1:9998/tika
# 单文件解析超时 (秒), PDF/大文档需适当调大
TIKA_TIMEOUT_SEC=60
# 业务库（订单 / 工单）：DBeaver 可打开查看 orders、tickets 表
BUSINESS_DB_PATH=./data/business.db
# 对话日志（P3-1）：每次问答落库；导出：uv run python -m src.chat_log --limit 100
CHAT_LOG_DB_PATH=./data/chat_logs.db
# FAQ 源数据（P3-3）：增删改走 POST /faqs*；导入可用 url 或 path；重建 POST /faqs/rebuild
FAQ_DB_PATH=./data/faqs.db
# 敏感词（P3-4）：增删改走 POST /sensitive-words*；启动不自动导入
SENSITIVE_DB_PATH=./data/sensitive.db
# 渠道配置（飞书等）：按登录用户隔离；前端「渠道配置」写入
# 飞书事件：POST /webhooks/feishu（公开固定地址；按 App ID/Token 匹配配置）
# 飞书用户 OAuth：GET /oauth/feishu/callback（查任务/清单/看板需 user_access_token）
# 开放平台权限：task:task:read、task:tasklist:read、task:section:read、
# contact:user:search、offline_access，并发布版本；扩权后用户需重新授权
CHANNELS_DB_PATH=./data/channels.db

# 智能体市场目录
AGENTS_DB_PATH=./data/agents.db

# 电商竞品分析 Agent（mp_agent）— SQLite 持久化 + CSV 产物
COMPETITOR_DB_PATH=./data/competitor.db
MP_AGENT_ARTIFACTS_DIR=./data/competitor_artifacts
MP_AGENT_CACHE_TTL_DAYS=3
# 可选：Apify / FlareSolverr（部分平台采集需要）
# APIFY_API_TOKEN=
# APIFY_API_TOKEN_2=
# FLARESOLVERR_URL=http://localhost:8191/v1
# FLARESOLVERR_MAX_CONCURRENT=3
# EUR_TO_USD=1.08

# 企业微信自建应用回调（P4+）：公开端点 GET/POST /webhooks/wecom
# 开启前请在企微后台配置「接收消息」URL 为 https://你的域名/webhooks/wecom
# WECOM_ENABLED=false
# WECOM_CORP_ID=wwxxxxxxxx
# WECOM_AGENT_ID=1000002
# WECOM_SECRET=应用Secret（本期被动回复可不填；后续主动发消息需要）
# WECOM_TOKEN=回调Token（与企微后台一致）
# WECOM_AES_KEY=EncodingAESKey（43位，与企微后台一致）
# WECOM_SESSION_PREFIX=ww:
# WECOM_UNSUPPORTED_MSG_REPLY=当前仅支持文字消息，请直接输入问题。

# Dify 外部知识库：POST /retrieval（原生 JSON）
# 运营后台「渠道配置 → Dify」可新建多把 Key（名称 / Endpoint 备忘 / 知识库 ID）
# 接口：GET/POST /integrations/dify/keys*（ops）
